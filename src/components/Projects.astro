---
import { projects } from '../data/projects';

const featured = projects.filter(p => p.featured);
const others = projects.filter(p => !p.featured);
---

<section id="works">
  <!-- Section label -->
  <div class="section-label">
    <span class="section-num">§ 02</span>
    <div class="section-line"></div>
    <span class="section-title">WORKS</span>
    <div class="section-line"></div>
  </div>

  <!-- Featured grid -->
  <div class="projects-grid">
    {featured.map((p, i) => (
      <div class={`project-card${p.url ? ' project-card--link' : ''}`}
           data-url={p.url}
           data-index={String(i + 1).padStart(2, '0')}>
        <div class="card-number">{String(i + 1).padStart(2, '0')}</div>
        <div class="card-top-line"></div>

        <div class="card-type">{p.duration}</div>
        <h3 class="card-title">{p.title}</h3>
        <p class="card-desc">{p.description}</p>

        <div class="card-stack">
          {p.stack.map(s => (
            <span class="stack-tag">{s}</span>
          ))}
        </div>

        {p.url && <div class="card-arrow">→</div>}
      </div>
    ))}
  </div>

  <!-- Other projects list -->
  <div class="other-label">// autres missions</div>
  <div class="others-list">
    {others.map((p, i) => (
      p.url
        ? <a href={p.url} target="_blank" rel="noopener" class="other-item">
            <span class="other-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="other-title">{p.title}</span>
            <span class="other-divider"></span>
            <span class="other-desc">{p.description}</span>
            <span class="other-duration">{p.duration}</span>
            <span class="other-arrow">→</span>
          </a>
        : <div class="other-item other-item--no-link">
            <span class="other-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="other-title">{p.title}</span>
            <span class="other-divider"></span>
            <span class="other-desc">{p.description}</span>
            <span class="other-duration">{p.duration}</span>
          </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.project-card--link').forEach(card => {
    card.addEventListener('click', () => {
      const url = card.dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    });
  });
</script>

<style>
  #works {
    padding: 100px 48px;
    position: relative;
    z-index: 1;
  }

  /* Section label */
  .section-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .section-num {
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    opacity: 0.6;
    white-space: nowrap;
  }

  .section-title {
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    opacity: 0.6;
    white-space: nowrap;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(0, 232, 198, 0.3), transparent);
  }

  .section-line:last-child {
    background: linear-gradient(to left, rgba(0, 232, 198, 0.3), transparent);
  }

  /* Featured grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    margin-bottom: 64px;
  }

  .project-card {
    position: relative;
    padding: 40px 32px;
    border: 1px solid var(--border);
    overflow: hidden;
    transition: border-color 0.3s, background 0.3s;
    cursor: default;
    display: block;
  }

  .project-card--link {
    cursor: pointer;
  }

  .project-card--link:hover {
    border-color: rgba(0, 232, 198, 0.4);
    background: rgba(0, 232, 198, 0.04);
  }

  .project-card--link:hover .card-top-line {
    opacity: 1;
  }

  .project-card--link:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .project-card--link:nth-child(even):hover {
    border-color: rgba(255, 77, 109, 0.4);
    background: rgba(255, 77, 109, 0.03);
  }

  .project-card--link:nth-child(even):hover .card-top-line {
    background: linear-gradient(to right, transparent, var(--red), transparent);
  }

  /* Big background number */
  .card-number {
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 64px;
    font-weight: 700;
    color: rgba(0, 232, 198, 0.05);
    line-height: 1;
    pointer-events: none;
    font-family: 'Syne', sans-serif;
  }

  .project-card:nth-child(even) .card-number {
    color: rgba(255, 77, 109, 0.05);
  }

  /* Animated top border */
  .card-top-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--cyan), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .card-type {
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    margin-bottom: 16px;
    opacity: 0.6;
  }

  .project-card:nth-child(even) .card-type {
    color: var(--red);
  }

  .card-title {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 28px;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .card-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack-tag {
    font-size: 9px;
    color: var(--faint);
    border: 1px solid var(--border);
    padding: 3px 8px;
    letter-spacing: 1px;
  }

  .card-arrow {
    position: absolute;
    bottom: 20px;
    right: 24px;
    color: var(--cyan);
    opacity: 0;
    transition: opacity 0.3s, transform 0.3s;
    transform: translateX(-8px);
    font-size: 18px;
  }

  /* Others list */
  .other-label {
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .others-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .other-item {
    display: grid;
    grid-template-columns: 40px 180px 1fr auto 160px 24px;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  a.other-item:hover {
    border-color: rgba(0, 232, 198, 0.3);
    background: rgba(0, 232, 198, 0.02);
  }

  .other-item--no-link {
    cursor: default;
    opacity: 0.6;
  }

  a.other-item:hover .other-arrow {
    color: var(--cyan);
    opacity: 1;
  }

  .other-index {
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 1px;
  }

  .other-title {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--text);
  }

  .other-divider {
    height: 1px;
    background: var(--border);
  }

  .other-desc {
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .other-duration {
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 1px;
    text-align: right;
    white-space: nowrap;
  }

  .other-arrow {
    color: var(--faint);
    font-size: 14px;
    opacity: 0.4;
    transition: color 0.2s, opacity 0.2s;
    text-align: right;
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    #works {
      padding: 60px 24px;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .other-item {
      grid-template-columns: 32px 1fr 24px;
    }
    .other-divider, .other-desc, .other-duration { display: none; }
  }
</style>
