---
import { profile } from '../data/profile';
---

<section id="contact">
  <div class="section-label">
    <span class="section-num">§ 04</span>
    <div class="section-line"></div>
    <span class="section-title">CONTACT</span>
    <div class="section-line"></div>
  </div>

  <div class="contact-layout">
    <!-- Left: heading -->
    <div class="contact-left">
      <h2 class="contact-heading">
        Un projet ?<br />
        <span class="accent">Parlons-en.</span>
      </h2>
      <p class="contact-sub">
        Disponible pour des missions freelance à Rennes et en remote.<br />
        Architecture, lead dev, développement web & mobile.
      </p>

      <!-- Coordinates decoration -->
      <div class="contact-deco">
        <span>48.1173°N</span>
        <div class="deco-line"></div>
        <span>1.6778°W</span>
      </div>
    </div>

    <!-- Right: links -->
    <div class="contact-links">
      <a href={profile.social.linkedin} target="_blank" rel="noopener" class="contact-link">
        <div class="link-left">
          <span class="link-label">LINKEDIN</span>
        </div>
        <span class="link-value">/in/julien-dhilly</span>
        <span class="link-arrow">→</span>
      </a>

      <a href={profile.social.github} target="_blank" rel="noopener" class="contact-link">
        <div class="link-left">
          <span class="link-label">GITHUB</span>
        </div>
        <span class="link-value">/jdhilly</span>
        <span class="link-arrow">→</span>
      </a>

      {/* <a href={profile.social.cv} download class="contact-link contact-link--highlight">
        <div class="link-left">
          <span class="link-label">CV</span>
        </div>
        <span class="link-value">Télécharger PDF</span>
        <span class="link-arrow">↓</span>
      </a> */}
    </div>
  </div>
</section>

<style>
  #contact {
    padding: 100px 48px 60px;
    position: relative;
    z-index: 1;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .section-num, .section-title {
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    opacity: 0.6;
    white-space: nowrap;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(0, 232, 198, 0.3), transparent);
  }

  .section-line:last-child {
    background: linear-gradient(to left, rgba(0, 232, 198, 0.3), transparent);
  }

  /* Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Left */
  .contact-heading {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 28px;
  }

  .accent { color: var(--cyan); }

  .contact-sub {
    font-size: 13px;
    color: var(--faint);
    line-height: 1.9;
    max-width: 380px;
    margin-bottom: 40px;
  }

  .contact-deco {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 2px;
    opacity: 0.5;
  }

  .deco-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    max-width: 60px;
  }

  /* Links */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 24px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .contact-link:hover {
    border-color: rgba(0, 232, 198, 0.4);
    background: rgba(0, 232, 198, 0.04);
  }

  .contact-link:hover .link-arrow {
    color: var(--cyan);
  }

  .contact-link--highlight {
    border-color: rgba(255, 77, 109, 0.2);
  }

  .contact-link--highlight:hover {
    border-color: rgba(255, 77, 109, 0.5);
    background: rgba(255, 77, 109, 0.03);
  }

  .contact-link--highlight:hover .link-arrow {
    color: var(--red);
  }

  .link-label {
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 3px;
    opacity: 0.6;
  }

  .contact-link--highlight .link-label {
    color: var(--red);
  }

  .link-value {
    font-size: 13px;
    color: var(--muted);
    flex: 1;
    text-align: right;
    margin-right: 16px;
  }

  .link-arrow {
    color: var(--faint);
    font-size: 16px;
    transition: color 0.2s;
  }

  @media (max-width: 768px) {
    #contact {
      padding: 60px 24px 40px;
    }
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
