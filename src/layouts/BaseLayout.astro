---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Julien Dhilly — Architecte Logiciel & Lead Dev Freelance à Rennes",
  description = "Architecte logiciel, Lead Dev et développeur freelance basé à Rennes. +15 ans d'expérience en architecture logicielle, NestJS, TypeScript, cloud AWS et développement agentic IA. Disponible pour missions.",
  ogImage = "/images/og-image.jpg",
} = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href="https://jdhilly.dev" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jdhilly.dev" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={`https://jdhilly.dev${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Julien Dhilly — Architecte Logiciel Freelance" />
    <meta property="og:site_name" content="jdhilly.dev" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <div style="position: relative; z-index: 1;">
      <slot />
    </div>

    <!-- WebMCP -->
    <script src="/scripts/webmcp.js" defer></script>
  </body>
</html>
